val wildcard = match 123 {
  else => "abcd"
}
val _: String = wildcard

val arr = [1, 2, 3]
val item = arr[0]

val res1 = match item {
  None => 0,
  else s => s + 1
}
val _: Int = res1

val res2 = match item {
  None => 0,
  1 a => a + 1,
  else s => s + 1
}
val _: Int = res2

val res3 = match item {
  1 a => a + 1,
  else => 0
}
val _: Int = res3

enum Color { Red, Green, Blue }
val colors = [Color.Red, Color.Green, Color.Blue]
val col = colors[0]

val res4 = match col {
  Color.Red c => c,
  Color.Green c => c,
  else => Color.Blue
}
val _: Color = res4

enum Color2 { RGB(r: Int, g: Int, b: Int) }
val col2 = Color2.RGB(r: 0, g: 0, b: 0)
val res5 = match col2 {
  Color2.RGB(r, g, b) => r + g + b
}
val _: Int = res5

// Alternate (v2) syntax for wildcard/catchall case kind
val wildcard2 = match 123 {
  else => "abcd"
}
val _: String = wildcard2

val x = match (Color.Red, Color.Green) {
  (Color.Red, Color.Red) => 1,
  (Color.Red, Color.Green) => 2,
  (Color.Red, Color.Blue) => 3,
  (Color.Green, Color.Red) => 4,
  (Color.Green, Color.Green) => 5,
  (Color.Green, Color.Blue) => 6,
  (Color.Blue, Color.Red) => 7,
  (Color.Blue, Color.Green) => 8,
  (Color.Blue, Color.Blue) => 9,
}

val colorArr = [(Color.Red, Color.Green)]
val y = match colorArr[0] {
  None => 0,
  (Color.Red, Color.Red) => 1,
  (Color.Red, Color.Green) => 2,
  (Color.Red, Color.Blue) => 3,
  (Color.Green, Color.Red) => 4,
  (Color.Green, Color.Green) => 5,
  (Color.Green, Color.Blue) => 6,
  (Color.Blue, Color.Red) => 7,
  (Color.Blue, Color.Green) => 8,
  (Color.Blue, Color.Blue) => 9,
}

val z = match colorArr[0] {
  None => 0,
  else => 1,
}

val colorArr2 = [(Color.Red, Some(true)), (Color.Blue, None)]
val w = match colorArr2[0] {
  None => 0,
  (Color.Red, None) => 0,
  (Color.Red, false) => 0,
  (Color.Red, true) => 1,
  (Color.Green, None) => 0,
  (Color.Green, false) => 0,
  (Color.Green, true) => 0,
  (Color.Blue, None) => 1,
  (Color.Blue, false) => 0,
  (Color.Blue, true) => 0,
}

val _ = match colorArr2[0] {
  None => 0,
  (_, None) => 0,
  (a, b) => {
    val _: Color = a

    // TODO: this could potentially be narrowed more, since b _must_ be non-None here
    val _: Bool? = b

    2
  }
}

val _ = match (true, "asdf") {
  (true, a) => 0,
  (false, a) => 1,
}
val _ = match (Color.Blue, "asdf") {
  (Color.Red, a) => 0,
  (Color.Blue, a) => 0,
  (Color.Green, a) => 0,
}

enum Foo<T> { Bar(t: T), Baz }
val fooArr = [(Foo.Bar(t: 1), Foo.Bar(t: 2)), (Foo.Baz, Foo.Bar(t: 3))]
val _ = match fooArr[0] {
  None => 0,
  (a, b) => {
    1
  }
}
val _ = match fooArr[0] {
  (a, b) => {
    1
  }
  else => 0
}
val _ = match fooArr[0] {
  None => 0,
  (Foo.Baz, a) => 1,
  (Foo.Bar, a) => 2,
}
val _ = match fooArr[0] {
  (Foo.Bar(a), Foo.Bar(b)) => a + b,
  else => 0
}
