enum Color { Red, Green, Blue }

val colorArr = [(Color.Red, Some(true)), (Color.Blue, None)]

val _ = match colorArr[0] {
  None => 0,
  (a, b) => 1,
  else => 2,
}

val _ = match colorArr[0] {
  (a, b) => 1,
}

val _ = match (Color.Blue, "asdf") {
  (Color.Red, a) => 0,
  (Color.Blue, a) => 0,
  (Color.Red, a) => 0,
}

val _ = match (Color.Blue, Color.Red) {
  (Color.Red, a) => 0,
  (Color.Red, Color.Blue) => 0,
}
